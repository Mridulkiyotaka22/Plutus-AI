# PLUTUS AI backend: local development configuration
# Copy to .env and generate a unique SECRET_KEY before running Django.
SECRET_KEY=replace-this-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank for local SQLite. Set a Supabase PostgreSQL URI only when needed.
DATABASE_URL=

# Development CORS. Django allows origins in DEBUG mode in this project.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080

# Optional: only required for live Groq-backed assistant responses.
# Never put this key in Flutter or commit a real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Market data provider. yfinance does not require an API key, but availability is not guaranteed.
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_CACHE_TTL=300
